# Apollo GraphQL Server Environment Configuration.
PORT=4000
NODE_ENV=development

# Execution Mode:
# Set to 'true' in AWS ECS Fargate to invoke Lambda functions
# Set to 'false' for local development to use direct PostgreSQL connection
USE_LAMBDA=false

# AWS Region & Lambda Function Names (used when USE_LAMBDA=true)
AWS_REGION=ap-south-1
LAMBDA_CREATE_EMPLOYEE=createEmployee
LAMBDA_GET_EMPLOYEES=getEmployees
LAMBDA_GET_EMPLOYEE=getEmployee
LAMBDA_UPDATE_EMPLOYEE=updateEmployee
LAMBDA_DELETE_EMPLOYEE=deleteEmployee

# Direct Database Connection (used when USE_LAMBDA=false or local dev)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=employeedb
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
