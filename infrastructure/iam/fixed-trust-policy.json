{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::977527528431:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:Manojkumar962952@126284997/devops-serverless-graphql-platform@1463040510:*",
            "repo:Manojkumar962952/devops-serverless-graphql-platform:*",
            "repo:*devops-serverless-graphql-platform:*"
          ]
        }
      }
    }
  ]
}
